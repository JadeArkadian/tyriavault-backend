<?xml version="1.0" encoding="UTF-8" ?>
<project name="tyriavault" database="PostgreSQL" id="0742b151-06f8-47b3-8fe7-a83968be0f5c" >
	<schema name="schema_tyriavault" >
		<table name="achievements" prior="achievement" >
			<column name="id" type="integer" mandatory="y" />
			<column name="name_es" type="text" mandatory="y" />
			<column name="name_fr" type="text" mandatory="y" />
			<column name="name_en" type="text" mandatory="y" />
			<column name="name_de" type="text" mandatory="y" />
			<column name="description_es" type="text" />
			<column name="description_fr" type="text" />
			<column name="description_en" type="text" />
			<column name="description_de" type="text" />
			<column name="achievement_type" prior="type" type="varchar" length="60" mandatory="y" />
			<column name="flags" type="jsonb" />
			<column name="icon_url" type="text" />
			<column name="last_fetched" prior="last_fetch" type="timestamptz" mandatory="y" >
				<defo><![CDATA[CURRENT_TIMESTAMP]]></defo>
			</column>
			<index name="pk_achievements" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
		</table>
		<table name="api_keys" prior="api_key" >
			<comment><![CDATA[Api keys used to consume the gw2 api services]]></comment>
			<column name="id" type="integer" length="32" mandatory="y" >
				<identity><![CDATA[GENERATED  BY DEFAULT AS IDENTITY]]></identity>
			</column>
			<column name="api_key" type="varchar" length="80" mandatory="y" />
			<column name="permissions" type="jsonb" />
			<column name="game_account_uuid" prior="game_account_id" type="uuid" />
			<column name="last_fetched" prior="last_time_fetched" type="timestamptz" >
				<defo><![CDATA[CURRENT_TIMESTAMP]]></defo>
			</column>
			<index name="pk_api_keys" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="unq_api_keys" unique="UNIQUE_INDEX" >
				<column name="api_key" />
			</index>
			<index name="idx_api_keys" unique="NORMAL" >
				<column name="game_account_uuid" />
			</index>
			<fk name="fk_api_keys_game_accounts" to_schema="schema_tyriavault" to_table="game_accounts" delete_action="setNull" update_action="cascade" >
				<fk_column name="game_account_uuid" pk="uuid" />
			</fk>
		</table>
		<table name="bank" prior="ba" spec="" >
			<comment><![CDATA[Table holding info about every single slot in bank storage for every single account]]></comment>
			<column name="id" type="bigint" length="64" mandatory="y" >
				<identity><![CDATA[GENERATED  BY DEFAULT AS IDENTITY]]></identity>
				<comment><![CDATA[Id autogenerated by TyrianAccount]]></comment>
			</column>
			<column name="game_account_uuid" prior="game_account_id" type="uuid" mandatory="y" >
				<comment><![CDATA[The uuid of the game account holding in its bank this item]]></comment>
			</column>
			<column name="item_id" type="bigint" >
				<comment><![CDATA[The item stored. NULL means that this slot is empty]]></comment>
			</column>
			<column name="stack_count" type="integer" >
				<comment><![CDATA[The amount of items stacked items of this type]]></comment>
			</column>
			<column name="charges" type="integer" >
				<comment><![CDATA[Remaining charges of this item if there are any (ie a recyling kit). Can be NULL]]></comment>
			</column>
			<column name="dye01_id" prior="dyes" type="integer" >
				<comment><![CDATA[Color (if any) assigned to slot 1]]></comment>
			</column>
			<column name="dye02_id" type="integer" >
				<comment><![CDATA[Color (if any) assigned to slot 2]]></comment>
			</column>
			<column name="dye03_id" type="integer" >
				<comment><![CDATA[Color (if any) assigned to slot 3]]></comment>
			</column>
			<column name="dye04_id" type="integer" >
				<comment><![CDATA[Color (if any) assigned to slot 4]]></comment>
			</column>
			<column name="slot" type="integer" mandatory="y" >
				<comment><![CDATA[The slot of the storage]]></comment>
			</column>
			<index name="pk_bank" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<fk name="fk_bank_dyes_01" to_schema="schema_tyriavault" to_table="dyes" >
				<fk_column name="dye01_id" pk="id" />
			</fk>
			<fk name="fk_bank_dyes_02" to_schema="schema_tyriavault" to_table="dyes" >
				<fk_column name="dye02_id" pk="id" />
			</fk>
			<fk name="fk_bank_dyes_03" to_schema="schema_tyriavault" to_table="dyes" >
				<fk_column name="dye03_id" pk="id" />
			</fk>
			<fk name="fk_bank_dyes_04" to_schema="schema_tyriavault" to_table="dyes" >
				<fk_column name="dye04_id" pk="id" />
			</fk>
			<fk name="fk_bank_game_accounts" to_schema="schema_tyriavault" to_table="game_accounts" delete_action="cascade" update_action="cascade" options="" >
				<fk_column name="game_account_uuid" pk="uuid" />
			</fk>
			<fk name="fk_bank_items_cache" to_schema="schema_tyriavault" to_table="items" delete_action="setNull" update_action="cascade" >
				<fk_column name="item_id" pk="id" />
			</fk>
		</table>
		<table name="characters" prior="charact" generator_rows="225" >
			<column name="id" type="integer" length="32" mandatory="y" >
				<identity><![CDATA[GENERATED  BY DEFAULT AS IDENTITY]]></identity>
			</column>
			<column name="game_account_uuid" prior="game_account_id" type="uuid" >
				<comment><![CDATA[uuId referencing the game_account who own this character]]></comment>
			</column>
			<column name="name" type="varchar" length="100" mandatory="y" />
			<column name="race_id" prior="race" type="integer" mandatory="y" />
			<column name="gender_id" prior="gender" type="integer" mandatory="y" >
				<defo><![CDATA[1]]></defo>
			</column>
			<column name="profession_id" prior="profession" type="integer" mandatory="y" />
			<column name="char_level" prior="level" type="integer" mandatory="y" >
				<defo><![CDATA[1]]></defo>
			</column>
			<index name="pk_characters" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="unq_name_characters" unique="UNIQUE_KEY" >
				<column name="name" />
			</index>
			<index name="idx_characters" unique="NORMAL" >
				<column name="game_account_uuid" />
			</index>
			<fk name="fk_characters_genders" to_schema="schema_tyriavault" to_table="genders" delete_action="cascade" update_action="cascade" >
				<fk_column name="gender_id" pk="id" />
			</fk>
			<fk name="fk_characters_races" to_schema="schema_tyriavault" to_table="races" delete_action="cascade" update_action="cascade" >
				<fk_column name="race_id" pk="id" />
			</fk>
			<fk name="fk_characters_professions" to_schema="schema_tyriavault" to_table="professions" delete_action="cascade" update_action="cascade" >
				<fk_column name="profession_id" pk="id" />
			</fk>
			<fk name="fk_characters_game_accounts" to_schema="schema_tyriavault" to_table="game_accounts" delete_action="cascade" update_action="cascade" >
				<fk_column name="game_account_uuid" pk="uuid" />
			</fk>
		</table>
		<table name="currencies" prior="currenci" generator_rows="100" >
			<comment><![CDATA[Table describing the diferents currencies of Tyria]]></comment>
			<column name="id" type="integer" length="32" mandatory="y" >
				<comment><![CDATA[Id of the currency. Given by the GW2 API]]></comment>
			</column>
			<column name="name_es" prior="names_es" type="varchar" length="100" mandatory="y" >
				<comment><![CDATA[Name in spanish]]></comment>
			</column>
			<column name="name_fr" prior="names_fr" type="varchar" length="100" mandatory="y" >
				<comment><![CDATA[Name in french]]></comment>
			</column>
			<column name="name_en" type="varchar" length="100" mandatory="y" >
				<comment><![CDATA[Name in english]]></comment>
			</column>
			<column name="name_de" type="varchar" length="100" mandatory="y" >
				<comment><![CDATA[Name in german]]></comment>
			</column>
			<column name="description_es" type="text" >
				<comment><![CDATA[The description in spanish]]></comment>
			</column>
			<column name="description_fr" type="text" >
				<comment><![CDATA[The description in french]]></comment>
			</column>
			<column name="description_en" type="text" >
				<comment><![CDATA[The description in english]]></comment>
			</column>
			<column name="description_de" type="text" >
				<comment><![CDATA[The description in german]]></comment>
			</column>
			<column name="icon_url" prior="icon" type="varchar" >
				<comment><![CDATA[URL of the icon representing the currency]]></comment>
			</column>
			<index name="pk_currencies" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
		</table>
		<table name="dyes" prior="dye" >
			<comment><![CDATA[Dyes existing in the game]]></comment>
			<column name="id" type="integer" mandatory="y" >
				<comment><![CDATA[Id assigned by the GW2 API]]></comment>
			</column>
			<column name="name_es" type="varchar" length="90" mandatory="y" >
				<comment><![CDATA[Name in spanish]]></comment>
			</column>
			<column name="name_fr" type="varchar" length="90" mandatory="y" >
				<comment><![CDATA[Name in french]]></comment>
			</column>
			<column name="name_en" type="varchar" length="90" mandatory="y" >
				<comment><![CDATA[Name in english]]></comment>
			</column>
			<column name="name_de" type="varchar" length="90" mandatory="y" >
				<comment><![CDATA[Name in german]]></comment>
			</column>
			<column name="color" type="char" length="14" mandatory="y" >
				<comment><![CDATA[Color in rgb format like "[RRR,GGG,BBB]" being RRR GGG and BBB parseable integer numbers]]></comment>
			</column>
			<index name="pk_dyes" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
		</table>
		<table name="emotes" prior="emote" generator_rows="100" >
			<comment><![CDATA[Table stocking info about the unlockable emotes of the game]]></comment>
			<column name="id" type="integer" length="32" mandatory="y" >
				<identity><![CDATA[GENERATED  BY DEFAULT AS IDENTITY]]></identity>
				<comment><![CDATA[Id of the emote. Assigned by TyriaAccount]]></comment>
			</column>
			<column name="name" type="varchar" length="100" >
				<comment><![CDATA[Unique name of the emote. It's the id from GW2 API]]></comment>
			</column>
			<column name="command" type="varchar" length="50" mandatory="y" >
				<comment><![CDATA[English command of the emote]]></comment>
			</column>
			<column name="unlocking_item_id" type="bigint" >
				<comment><![CDATA[First item that allows the unlocking of the emote]]></comment>
			</column>
			<index name="pk_emotes_0" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="unq_emotes_name" unique="UNIQUE_KEY" >
				<column name="name" />
			</index>
			<fk name="fk_emotes_items_cache" to_schema="schema_tyriavault" to_table="items" delete_action="setNull" update_action="cascade" >
				<fk_column name="unlocking_item_id" pk="id" />
			</fk>
		</table>
		<table name="game_accounts" prior="tbl" generator_rows="150" >
			<comment><![CDATA[Table holding info about the game account of GW2]]></comment>
			<column name="uuid" prior="id" type="uuid" mandatory="y" >
				<comment><![CDATA[Game account UUID -> Given always by GW2 API]]></comment>
			</column>
			<column name="account_name" type="varchar" length="80" mandatory="y" >
				<comment><![CDATA[The name of the game account]]></comment>
			</column>
			<column name="world_id" type="integer" >
				<comment><![CDATA[Id referencing the world where the account is from]]></comment>
			</column>
			<column name="creation_date" type="timestamptz" mandatory="y" >
				<defo><![CDATA[CURRENT_TIMESTAMP]]></defo>
				<comment><![CDATA[Creation date of this account]]></comment>
			</column>
			<column name="fractal_level" type="integer" mandatory="y" >
				<defo><![CDATA[1]]></defo>
				<comment><![CDATA[The fractal level of the account. Usually a number between 1 and 100]]></comment>
			</column>
			<column name="last_modified" type="timestamptz" mandatory="y" >
				<defo><![CDATA[CURRENT_TIMESTAMP]]></defo>
				<comment><![CDATA[When was this account last time modified (as perceived by the API) ?]]></comment>
			</column>
			<column name="content_access" type="jsonb" >
				<comment><![CDATA[The flags assigned to your account telling you which expansions you own.]]></comment>
			</column>
			<column name="last_fetched" type="timestamptz" mandatory="y" >
				<defo><![CDATA[CURRENT_TIMESTAMP]]></defo>
				<comment><![CDATA[Last time the data of this item was fetched from the API]]></comment>
			</column>
			<index name="game_accounts_pkey" unique="PRIMARY_KEY" >
				<column name="uuid" />
			</index>
			<fk name="fk_game_accounts_worlds" to_schema="schema_tyriavault" to_table="worlds" delete_action="setNull" update_action="cascade" >
				<fk_column name="world_id" pk="id" />
			</fk>
		</table>
		<table name="genders" prior="gend" generator_rows="100" >
			<comment><![CDATA[Table holding info about the available gender in the game]]></comment>
			<column name="id" type="integer" mandatory="y" >
				<comment><![CDATA[The gender id. Assigned manually by TyriaVault]]></comment>
			</column>
			<column name="name_es" type="varchar" length="100" mandatory="y" >
				<comment><![CDATA[The name in spanish]]></comment>
			</column>
			<column name="name_fr" type="varchar" length="100" mandatory="y" >
				<comment><![CDATA[The name in french]]></comment>
			</column>
			<column name="name_en" type="varchar" length="100" mandatory="y" >
				<comment><![CDATA[The name in english]]></comment>
			</column>
			<column name="name_de" type="varchar" length="100" mandatory="y" >
				<comment><![CDATA[The name in german]]></comment>
			</column>
			<index name="pk_genders" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
		</table>
		<table name="item_details" prior="item_detai" generator_rows="225" spec="" >
			<column name="item_id" type="bigint" mandatory="y" />
			<column name="details" type="jsonb" mandatory="y" />
			<index name="pk_item_details" unique="PRIMARY_KEY" >
				<column name="item_id" />
			</index>
			<index name="idx_item_details" unique="NORMAL" spec="USING GIN" >
				<column name="details" />
			</index>
			<fk name="fk_item_details_items_cache" to_schema="schema_tyriavault" to_table="items" delete_action="cascade" update_action="cascade" >
				<fk_column name="item_id" pk="id" />
			</fk>
		</table>
		<table name="item_types" prior="item_type" generator_rows="100" >
			<column name="id" type="integer" length="32" mandatory="y" >
				<identity><![CDATA[GENERATED  BY DEFAULT AS IDENTITY]]></identity>
			</column>
			<column name="name_es" type="varchar" length="100" mandatory="y" />
			<column name="name_fr" type="varchar" length="100" mandatory="y" />
			<column name="name_en" type="varchar" length="100" mandatory="y" />
			<column name="name_de" type="varchar" length="100" mandatory="y" />
			<index name="pk_item_type" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
		</table>
		<table name="items" prior="items_cache" generator_rows="150" >
			<column name="id" type="bigint" mandatory="y" >
				<comment><![CDATA[The item ID, given by the GW2 API]]></comment>
			</column>
			<column name="name_es" prior="name" type="varchar" length="200" mandatory="y" >
				<comment><![CDATA[Name in spanish]]></comment>
			</column>
			<column name="name_fr" prior="names_fr" type="varchar" length="200" mandatory="y" >
				<comment><![CDATA[Name in french]]></comment>
			</column>
			<column name="name_en" type="varchar" length="200" mandatory="y" >
				<comment><![CDATA[Name in english]]></comment>
			</column>
			<column name="name_de" type="varchar" length="200" mandatory="y" >
				<comment><![CDATA[Name in german]]></comment>
			</column>
			<column name="item_type_id" type="integer" >
				<comment><![CDATA[The id of the Item Type]]></comment>
			</column>
			<column name="chat_link" type="varchar" mandatory="y" >
				<comment><![CDATA[String with the ingame chat link]]></comment>
			</column>
			<column name="icon_url" type="text" >
				<comment><![CDATA[Icon URL]]></comment>
			</column>
			<column name="description_es" type="text" >
				<comment><![CDATA[Description in spanish]]></comment>
			</column>
			<column name="description_fr" type="text" >
				<comment><![CDATA[Description in french]]></comment>
			</column>
			<column name="description_en" prior="description_english" type="text" >
				<comment><![CDATA[Description in english]]></comment>
			</column>
			<column name="description_de" type="text" >
				<comment><![CDATA[Description in german]]></comment>
			</column>
			<column name="rarity_id" type="integer" mandatory="y" >
				<comment><![CDATA[The rarity of the item]]></comment>
			</column>
			<column name="required_level" prior="item_level" type="integer" >
				<comment><![CDATA[The minimum level required level to use this item]]></comment>
			</column>
			<column name="vendor_value" type="integer" >
				<defo><![CDATA[0]]></defo>
				<comment><![CDATA[The value in coins when selling to a vendor. (Can be non-zero even when the item has the NoSell flag.)]]></comment>
			</column>
			<column name="flags" type="jsonb" >
				<comment><![CDATA[Flags applying to the item.]]></comment>
			</column>
			<column name="last_fetched" type="timestamptz" mandatory="y" >
				<defo><![CDATA[CURRENT_TIMESTAMP]]></defo>
				<comment><![CDATA[Last time the data of this item was fetched from the API]]></comment>
			</column>
			<index name="pk_items_cache" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="idx_items_cache_1" unique="NORMAL" >
				<column name="rarity_id" />
			</index>
			<index name="idx_items_cache_0" unique="NORMAL" >
				<column name="item_type_id" />
			</index>
			<fk name="fk_items_cache_item_type" to_schema="schema_tyriavault" to_table="item_types" delete_action="cascade" update_action="cascade" >
				<fk_column name="item_type_id" pk="id" />
			</fk>
			<fk name="fk_items_cache_rarities" to_schema="schema_tyriavault" to_table="rarities" delete_action="cascade" update_action="cascade" >
				<fk_column name="rarity_id" pk="id" />
			</fk>
		</table>
		<table name="miniatures" prior="miniature" >
			<comment><![CDATA[Table enumerating every mini found in the game]]></comment>
			<column name="id" type="integer" mandatory="y" >
				<comment><![CDATA[The mini ID. Assigned by the GW2 Api]]></comment>
			</column>
			<column name="icon_url" type="text" >
				<comment><![CDATA[The icon URL]]></comment>
			</column>
			<column name="name_es" type="varchar" length="200" mandatory="y" >
				<comment><![CDATA[The name in spanish]]></comment>
			</column>
			<column name="name_fr" type="varchar" length="200" mandatory="y" >
				<comment><![CDATA[The name in french]]></comment>
			</column>
			<column name="name_en" type="varchar" length="200" mandatory="y" >
				<comment><![CDATA[The name in english]]></comment>
			</column>
			<column name="name_de" type="varchar" length="200" mandatory="y" >
				<comment><![CDATA[The name in german]]></comment>
			</column>
			<column name="item_id" type="bigint" >
				<comment><![CDATA[The item associated to this mini]]></comment>
			</column>
			<index name="pk_miniatures" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<fk name="fk_miniatures_items_cache" to_schema="schema_tyriavault" to_table="items" >
				<fk_column name="item_id" pk="id" />
			</fk>
		</table>
		<table name="professions" prior="profession" generator_rows="100" >
			<comment><![CDATA[Table of the players professions (or classes)]]></comment>
			<column name="id" type="integer" mandatory="y" >
				<comment><![CDATA[The id of the profession. Given manually by TyriaVault]]></comment>
			</column>
			<column name="name_es" type="varchar" length="100" mandatory="y" >
				<comment><![CDATA[The name in spanish]]></comment>
			</column>
			<column name="name_fr" type="varchar" length="100" mandatory="y" >
				<comment><![CDATA[The name in french]]></comment>
			</column>
			<column name="name_en" type="varchar" length="100" mandatory="y" >
				<comment><![CDATA[The name in english]]></comment>
			</column>
			<column name="name_de" type="varchar" length="100" mandatory="y" >
				<comment><![CDATA[The name in german]]></comment>
			</column>
			<index name="pk_professions" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
		</table>
		<table name="races" prior="race" generator_rows="100" >
			<comment><![CDATA[The playable races of Tyria. Shouldn't never change.. well.. who knows]]></comment>
			<column name="id" type="integer" mandatory="y" >
				<comment><![CDATA[The id. Given manually by TyriaVault]]></comment>
			</column>
			<column name="name_es" prior="names_es" type="varchar" length="100" mandatory="y" >
				<comment><![CDATA[The name in spanish]]></comment>
			</column>
			<column name="name_fr" type="varchar" length="100" mandatory="y" >
				<comment><![CDATA[The name in french]]></comment>
			</column>
			<column name="name_en" type="varchar" length="100" mandatory="y" >
				<comment><![CDATA[The name in english]]></comment>
			</column>
			<column name="name_de" type="varchar" length="100" mandatory="y" >
				<comment><![CDATA[The name in german]]></comment>
			</column>
			<index name="pk_races" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
		</table>
		<table name="rarities" prior="rarit" generator_rows="100" >
			<comment><![CDATA[Existing item rarities of the game. Very unlikely to change.]]></comment>
			<column name="id" type="integer" mandatory="y" >
				<comment><![CDATA[The id of the rarity. Assigned (manually) by TyriaVault]]></comment>
			</column>
			<column name="name_es" prior="name" type="varchar" length="80" mandatory="y" />
			<column name="name_fr" type="varchar" length="80" mandatory="y" />
			<column name="name_en" type="varchar" length="80" mandatory="y" />
			<column name="name_de" type="varchar" length="80" mandatory="y" />
			<column name="color" type="char" length="14" mandatory="y" >
				<comment><![CDATA[The representing color tied to the rarity. For example, ascended gear is pink]]></comment>
			</column>
			<index name="pk_rarities" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
		</table>
		<table name="unlocked_dyes" prior="unlocked_dy" >
			<comment><![CDATA[Unlocked dyes for a given account]]></comment>
			<column name="game_account_uuid" prior="game_account_id" type="uuid" mandatory="y" >
				<comment><![CDATA[The game account having unlocked the dye]]></comment>
			</column>
			<column name="dye_id" type="integer" mandatory="y" >
				<comment><![CDATA[The unlocked dye]]></comment>
			</column>
			<column name="unlock_date" type="date" >
				<defo><![CDATA[CURRENT_TIMESTAMP]]></defo>
				<comment><![CDATA[The unlock date]]></comment>
			</column>
			<index name="pk_unlocked_dyes" unique="PRIMARY_KEY" >
				<column name="game_account_uuid" />
				<column name="dye_id" />
			</index>
			<index name="idx_unlocked_dyes" unique="NORMAL" >
				<column name="game_account_uuid" />
			</index>
			<fk name="fk_unlocked_dyes_game_accounts" to_schema="schema_tyriavault" to_table="game_accounts" delete_action="cascade" update_action="cascade" >
				<fk_column name="game_account_uuid" pk="uuid" />
			</fk>
			<fk name="fk_unlocked_dyes_dyes" to_schema="schema_tyriavault" to_table="dyes" >
				<fk_column name="dye_id" pk="id" />
			</fk>
		</table>
		<table name="unlocked_emotes" prior="emotes" generator_rows="225" >
			<comment><![CDATA[Unlocked emotes for a given game account]]></comment>
			<column name="game_account_uuid" prior="game_account_id" type="uuid" mandatory="y" >
				<comment><![CDATA[uuId referencing the game_account who unlocked this emote]]></comment>
			</column>
			<column name="emote_id" prior="emote_ide" type="integer" mandatory="y" >
				<comment><![CDATA[The id referencing the unlocked emote]]></comment>
			</column>
			<column name="unlock_date" type="timestamptz" >
				<defo><![CDATA[CURRENT_TIMESTAMP]]></defo>
				<comment><![CDATA[The unlock date]]></comment>
			</column>
			<index name="pk_unlocked_emotes" unique="PRIMARY_KEY" >
				<column name="game_account_uuid" />
				<column name="emote_id" />
			</index>
			<index name="idx_unlocked_emotes" unique="NORMAL" >
				<column name="game_account_uuid" />
			</index>
			<fk name="fk_unlocked_emotes_emotes" to_schema="schema_tyriavault" to_table="emotes" delete_action="cascade" update_action="cascade" >
				<fk_column name="emote_id" pk="id" />
			</fk>
			<fk name="fk_unlocked_emotes_game_accounts" to_schema="schema_tyriavault" to_table="game_accounts" delete_action="cascade" update_action="cascade" >
				<fk_column name="game_account_uuid" pk="uuid" />
			</fk>
		</table>
		<table name="unlocked_minis" prior="unlocked_min" >
			<comment><![CDATA[Table listing unlocked miniatures for a given game account]]></comment>
			<column name="mini_id" type="integer" mandatory="y" />
			<column name="game_account_uuid" type="uuid" mandatory="y" />
			<column name="unlock_date" type="date" >
				<defo><![CDATA[CURRENT_TIMESTAMP]]></defo>
				<comment><![CDATA[The unlock date]]></comment>
			</column>
			<index name="pk_unlocked_minis" unique="PRIMARY_KEY" >
				<column name="mini_id" />
				<column name="game_account_uuid" />
			</index>
			<index name="idx_unlocked_minis" unique="NORMAL" >
				<column name="game_account_uuid" />
			</index>
			<fk name="fk_unlocked_minis_miniatures" to_schema="schema_tyriavault" to_table="miniatures" >
				<fk_column name="mini_id" pk="id" />
			</fk>
			<fk name="fk_unlocked_minis_game_accounts" to_schema="schema_tyriavault" to_table="game_accounts" >
				<fk_column name="game_account_uuid" pk="uuid" />
			</fk>
		</table>
		<table name="wallet" prior="walle" generator_rows="225" >
			<comment><![CDATA[Table holding info about every currency holded by a game_account. AKA the account wallet]]></comment>
			<column name="currency_id" prior="curency_id" type="integer" mandatory="y" >
				<defo><![CDATA[0]]></defo>
				<comment><![CDATA[The Id of referencing the currency holded]]></comment>
			</column>
			<column name="game_account_uuid" prior="game_account_id" type="uuid" mandatory="y" >
				<comment><![CDATA[The uuid of the game account owning the currency]]></comment>
			</column>
			<column name="amount" prior="value" type="integer" >
				<defo><![CDATA[0]]></defo>
				<comment><![CDATA[The ammount of money]]></comment>
			</column>
			<index name="pk_wallet" unique="PRIMARY_KEY" >
				<column name="currency_id" />
				<column name="game_account_uuid" />
			</index>
			<index name="idx_wallet" unique="NORMAL" >
				<column name="game_account_uuid" />
			</index>
			<fk name="fk_wallet_game_accounts" to_schema="schema_tyriavault" to_table="game_accounts" delete_action="cascade" update_action="cascade" >
				<fk_column name="game_account_uuid" pk="uuid" />
			</fk>
			<fk name="fk_wallet_currencies" to_schema="schema_tyriavault" to_table="currencies" delete_action="cascade" update_action="cascade" >
				<fk_column name="currency_id" pk="id" />
			</fk>
		</table>
		<table name="wallet_history" prior="wallet_histo" generator_rows="225" >
			<comment><![CDATA[Table destined to record the evolution of some relevant owned currencies]]></comment>
			<column name="currency_id" prior="curency_id" type="integer" mandatory="y" >
				<comment><![CDATA[The Id of referencing the currency holded]]></comment>
			</column>
			<column name="game_account_uuid" prior="game_account_id" type="uuid" mandatory="y" >
				<comment><![CDATA[The uuid of the game account owning the currency]]></comment>
			</column>
			<column name="snapshot_time" type="timestamptz" mandatory="y" >
				<defo><![CDATA[CURRENT_TIMESTAMP]]></defo>
				<comment><![CDATA[The relevant timestamp for this tuple]]></comment>
			</column>
			<column name="amount" type="integer" mandatory="y" >
				<defo><![CDATA[0]]></defo>
				<comment><![CDATA[The ammount of money]]></comment>
			</column>
			<index name="pk_wallet_history" unique="PRIMARY_KEY" >
				<column name="currency_id" />
				<column name="game_account_uuid" />
				<column name="snapshot_time" />
			</index>
			<fk name="fk_wallet_history_currencies" to_schema="schema_tyriavault" to_table="currencies" delete_action="cascade" update_action="cascade" >
				<fk_column name="currency_id" pk="id" />
			</fk>
			<fk name="fk_wallet_history_game_accounts" to_schema="schema_tyriavault" to_table="game_accounts" delete_action="cascade" update_action="cascade" >
				<fk_column name="game_account_uuid" pk="uuid" />
			</fk>
		</table>
		<table name="worlds" prior="world" generator_rows="100" >
			<comment><![CDATA[The worlds (or servers) of the game. Content may change... or not.. who knows]]></comment>
			<column name="id" type="integer" mandatory="y" >
				<comment><![CDATA[Id of the world -> supplied by the GW2 API]]></comment>
			</column>
			<column name="name_es" type="varchar" length="100" mandatory="y" >
				<comment><![CDATA[Name in spanish]]></comment>
			</column>
			<column name="name_fr" type="varchar" length="100" mandatory="y" >
				<comment><![CDATA[Name in french]]></comment>
			</column>
			<column name="name_en" type="varchar" length="100" mandatory="y" >
				<comment><![CDATA[Name in english]]></comment>
			</column>
			<column name="name_de" type="varchar" length="100" mandatory="y" >
				<comment><![CDATA[Name in german]]></comment>
			</column>
			<index name="pk_worlds" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
		</table>
	</schema>
