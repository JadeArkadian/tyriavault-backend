# Example environment configuration for TyriaVault Backend
# Copy this file to .env (for development) or .env.test (for tests) and adjust values.

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tyriavault

# Guild Wars 2 API key (generate from your GW2 account management page)
GW2_API_KEY=REPLACE_ME

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=DEBUG

# Interval for worlds crawler in minutes (default 2880 = 48h)
WORLDS_CRAWLER_INTERVAL_MINUTES=2880

# Set ENV=test to force usage of .env.test (handled in config)
# ENV=development

